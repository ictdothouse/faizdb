{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaizDB Studio",
  "version": "0.1.0",
  "identifier": "com.ictdothouse.faizdb.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:27020",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FaizDB Studio — Enterprise & Robotics Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"]
  }
}
